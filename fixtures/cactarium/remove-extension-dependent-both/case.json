{
  "about": "A claim of a base package needed by a base thorn and an added one: its dependent is listed once",
  "packages": [
    "et--carpetx--both-need-lib",
    "max--lib"
  ],
  "present": [
    {
      "package": "et/carpetx",
      "version": "2026.5.1",
      "base": "carpetx",
      "enabled": [
        "CarpetX",
        "Loop",
        "Arith"
      ]
    },
    {
      "package": "max/lib",
      "version": "1.0.0",
      "enabled": [
        "Lib"
      ]
    }
  ],
  "remove": {
    "targets": [
      "max/lib"
    ],
    "extensions": {
      "et/carpetx": [
        "Arith"
      ]
    }
  },
  "expect": {
    "refusal": "HasDependents",
    "message": [
      "Other packages depend on max/lib:\n  et/carpetx@2026.5.1 (max/lib@^1.0).\nPass --no-deps"
    ]
  }
}
