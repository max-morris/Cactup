{
  "about": "Removing a package another one depends on refuses, naming the dependent",
  "present": [
    {
      "package": "max/z4c",
      "version": "1.2.0",
      "enabled": [
        "Z4c",
        "Z4cTest"
      ]
    },
    {
      "package": "et/carpetx",
      "version": "2026.5.1",
      "enabled": [
        "CarpetX"
      ]
    },
    {
      "package": "et/arith",
      "version": "1.3.0",
      "enabled": [
        "Arith"
      ]
    },
    {
      "package": "et/admbase",
      "version": "2026.5.1",
      "enabled": [
        "ADMBase"
      ]
    }
  ],
  "remove": {
    "targets": [
      "et/carpetx"
    ],
    "added-for": {
      "max/z4c": {
        "requested": true,
        "for-commit": "current"
      },
      "et/carpetx": {
        "requested": false,
        "by": [
          "max/z4c@1.2.0"
        ],
        "for-commit": "current"
      },
      "et/arith": {
        "requested": false,
        "by": [
          "et/carpetx@2026.5.1"
        ],
        "for-commit": "current"
      },
      "et/admbase": {
        "requested": true,
        "for-commit": "current"
      }
    }
  },
  "expect": {
    "refusal": "HasDependents",
    "message": [
      "Other packages depend on et/carpetx",
      "max/z4c@1.2.0 (et/carpetx@^2026.5)",
      "Pass --no-deps to remove only what was named"
    ]
  }
}
