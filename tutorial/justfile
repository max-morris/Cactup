# The Cactup tutorial's commands. `just` lists them; they work from anywhere
# under tutorial/. See README.md for what is behind each.

# Arguments reach the commands as "$@", each one word as typed: `just test -k
# "a or b"` keeps its quotes.
set positional-arguments

image := "cactup-tutorial:tutorial"
venv := justfile_directory() / ".venv"
lab := "cactup-tutorial-lab"

# List the recipes.
default:
    @just --list --unsorted

# --- build ------------------------------------------------------------------

# Build the tutorial image (an hour or more the first time; then only what changed).
[group('build')]
build *args:
    sh image/build.sh "$@"

# Move tutorial/cactup.pin to another cactup: `just pin master` (see UPDATING.md).
[group('build')]
pin commit:
    sh tools/move-pin.sh {{commit}}

# --- try it -----------------------------------------------------------------

# Start the tutorial in a fresh container, as one attendee has it, and print its address.
[group('try')]
lab port="8888":
    #!/bin/sh
    set -eu
    docker rm -f {{lab}} > /dev/null 2>&1 || true
    token=$(python3 -c 'import secrets; print(secrets.token_hex(8))')
    docker run -d --name {{lab}} -p 127.0.0.1:{{port}}:8888 --hostname cactup-tutorial \
        --cpus 4 --memory 8g --shm-size 1g -e CACTUP_TUTORIAL_TOKEN="$token" {{image}} > /dev/null
    printf 'starting'
    until curl -fs "http://127.0.0.1:{{port}}/api" > /dev/null 2>&1; do printf .; sleep 1; done
    echo
    echo "open http://127.0.0.1:{{port}}/lab?token=$token"
    echo "(just lab-shell: a shell in it; just lab-stop: remove it, and all done in it)"

# A shell in the `just lab` container, as the attendee.
[group('try')]
lab-shell:
    docker exec -it -u cactus -w /home/cactus {{lab}} bash -l

# Remove the `just lab` container.
[group('try')]
lab-stop:
    docker rm -f {{lab}}

# --- check ------------------------------------------------------------------

# The pytest suites (two minutes): `just test -k cyol`.
[group('check')]
test *args: _venv
    PYTHONPATH={{justfile_directory()}}/jupyter:{{justfile_directory()}}/deploy/hub {{venv}}/bin/python -m pytest tests "$@"

# Every notebook, headless, in fresh containers (about an hour): `just check --only 2,3`.
[group('check')]
check *args: _venv
    {{venv}}/bin/python tests/run_all.py "$@"

# The image's platform (install, update, SLURM) and a replayed build (ten minutes).
[group('check')]
check-platform:
    sh tests/platform/smoke.sh {{image}}
    sh tests/platform/replay.sh {{image}}

# A whole hub on this machine, checked end to end and in a browser: `just check-hub --only 1`.
[group('check')]
check-hub *args: _venv
    #!/bin/sh
    set -u
    export PATH="{{venv}}/bin:$PATH"
    status=0
    tests/hub/run.sh --keep "$@" && tests/hub/browse.sh || status=1
    tests/hub/run.sh --down
    exit $status

# All of the above.
[group('check')]
check-all: test check-platform check check-hub

# Make tutorial/.venv for the checks (again when tests/requirements.txt changes).
_venv:
    #!/bin/sh
    set -eu
    [ "{{venv}}/.made" -nt tests/requirements.txt ] && exit 0
    python3 -m venv "{{venv}}"
    "{{venv}}/bin/pip" install -q -r tests/requirements.txt -c jupyter/constraints.txt
    touch "{{venv}}/.made"

# --- deploy (on the server, in a checkout of this repository) -----------------

# Copy the image built here to the server: `just ship user@server` (Docker there; zstd on both).
[group('deploy')]
ship host:
    docker save {{image}} | zstd -T0 | ssh {{host}} 'zstd -d | docker load'

# Set the server up, once: deploy/.env, Docker access, the token's directory, Apache in front (asks sudo).
[group('deploy')]
setup:
    sh deploy/setup.sh

# Start the hub, or bring it up to date after editing deploy/.env or pulling.
[group('deploy')]
up:
    #!/bin/sh
    set -eu
    cd deploy
    if [ ! -f .env ]; then
        echo "no deploy/.env yet: run 'just setup' first" >&2
        exit 1
    fi
    if ! docker info > /dev/null 2>&1; then
        echo "no access to Docker: 'just setup' (then log in again), or start Docker" >&2
        exit 1
    fi
    get() { sed -n "s/^$1=//p" .env | tail -1; }
    image=$(get TUTORIAL_IMAGE); image=${image:-{{image}}}
    if ! docker image inspect "$image" > /dev/null 2>&1; then
        echo "no image $image here: 'just build' on this machine, or 'just ship' it from another" >&2
        exit 1
    fi
    shared=$(get SHARED_DIR); shared=${shared:-/srv/cactup-tutorial}
    if [ ! -d "$shared" ]; then
        echo "no $shared (SHARED_DIR) yet: run 'just setup'" >&2
        exit 1
    fi
    docker compose up -d --build
    docker compose ps

# Stop the hub and Caddy (attendees' containers keep running; README: full teardown).
[group('deploy')]
down:
    cd deploy && docker compose down

# What is running: the hub, Caddy, and every attendee's container.
[group('deploy')]
status:
    cd deploy && docker compose ps
    docker ps --filter label=org.cactup-tutorial.attendee --format 'table {{{{.Names}}\t{{{{.Status}}\t{{{{.RunningFor}}'

# Follow the hub's and Caddy's logs.
[group('deploy')]
logs:
    cd deploy && docker compose logs -f --tail 50

# Show the session token, big, for the room (follows rotations; Ctrl-C ends).
[group('deploy')]
token *args:
    deploy/token "$@"

# Make a new session token now (say, once the room has signed up).
[group('deploy')]
rotate:
    deploy/token --rotate

# Make one account (an admin's, say), asking for its password: `just account ada`.
[group('deploy')]
account name:
    cd deploy && docker compose exec -it hub python3 -m cactup_cyol.make_users --name {{name}}

# Make accounts with random passwords, printed for handing out: `just accounts 30`.
[group('deploy')]
accounts count prefix="attendee":
    cd deploy && docker compose exec hub python3 -m cactup_cyol.make_users {{count}} --prefix {{prefix}}

# Set a forgotten password: `just password ada`.
[group('deploy')]
password name:
    cd deploy && docker compose exec -it hub python3 -m cactup_cyol.set_password {{name}}

# Reload Caddy's config and the certificate files (after the site renews its certificate).
[group('deploy')]
reload-caddy:
    cd deploy && docker compose exec "$(docker compose ps --services | grep caddy)" sh /etc/caddy/run.sh reload
