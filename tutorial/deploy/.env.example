# Copy to .env and edit. See "Deploying" in tutorial/README.md. Every setting
# the deployment reads is here.

# -- how attendees reach the server --------------------------------------------
# tls:   Caddy serves HTTPS on port 443 and redirects port 80 to it (both
#        always; the ports below are for plain only). Set TLS too.
# plain: Caddy serves plain HTTP on PLAIN_BIND:PLAIN_PORT, for the site's own
#        proxy to put HTTPS in front of (see the README for what that proxy
#        must do).
COMPOSE_PROFILES=tls
# With COMPOSE_PROFILES=tls, one of:
#   auto      Let's Encrypt: DOMAIN must point at this machine, and ports 80
#             and 443 be open to the internet.
#   provided  the site's certificate: cert.pem (the full chain: the server
#             certificate, then the intermediates) and key.pem (unencrypted)
#             in TLS_CERT_DIR, copied in (links, such as certbot's live/
#             directory, don't resolve in Caddy's container). After the
#             site renews them:
#             docker compose exec caddy caddy reload --force --config /etc/caddy/Caddyfile
TLS=auto
DOMAIN=tutorial.example.org
TLS_CERT_DIR=./caddy/certs
# With COMPOSE_PROFILES=plain only: where the site's proxy finds the server.
# 127.0.0.1 if the proxy runs on this machine; otherwise this machine's address
# on the network they share (and firewall PLAIN_PORT to the proxy alone).
PLAIN_BIND=127.0.0.1
PLAIN_PORT=8000
# 1: the hub's cookies are sent over HTTPS only (attendees always come over
# HTTPS, Caddy's or the site proxy's). 0 only for plain HTTP end to end, as in
# tutorial/tests/hub.
SECURE_COOKIES=1

# -- the session token -----------------------------------------------------------
# A directory on this machine for the token file, readable by the group whose
# members may see the token (`./token` prints it):
#   sudo groupadd cactup-tutorial
#   sudo install -d -m 2770 -g cactup-tutorial /srv/cactup-tutorial
#   SHARED_GID=$(getent group cactup-tutorial | cut -d: -f3)
# Under rootless Docker the hub can't write a directory it reaches through
# a group (its container keeps none of yours): use a directory of your own,
# and 0 here (your own group, seen from the container).
SHARED_DIR=/srv/cactup-tutorial
SHARED_GID=
# Minutes between new tokens; 0 never replaces one by time (only `./token
# --rotate` does).
TOKEN_ROTATE_MINUTES=60
# Minutes the previous token still makes accounts after a new one replaces it.
TOKEN_GRACE_MINUTES=5

# -- the hub -----------------------------------------------------------------------
# Comma-separated usernames that get the hub's admin page (/hub/admin). Their
# accounts are made on the machine, never by signing up:
#   docker compose exec -it hub python3 -m cactup_cyol.make_users --name NAME
HUB_ADMINS=
# The Docker socket the hub starts containers through (it can do anything
# Docker can: the hub is as powerful as root on this machine). Rootless
# Docker: $XDG_RUNTIME_DIR/docker.sock, usually /run/user/UID/docker.sock.
DOCKER_SOCKET=/var/run/docker.sock
# The attendees' image (built by tutorial/image/build.sh, or loaded).
TUTORIAL_IMAGE=cactup-tutorial:tutorial
# The attendees' network. Change it only to run a second deployment (or
# tutorial/tests/hub) on the same machine.
USER_NETWORK=cactup-tutorial-users

# -- each attendee's container (see tutorial/SIZING.md) -------------------------------
CPUS_PER_ATTENDEE=4
# 1: give each container a cpuset of CPUS_PER_ATTENDEE cores of its own. The
# machine's cores are cut into slices of that size; cores left over (fewer
# than one slice) go unused. Needs Docker to apply cpusets: rootful Docker,
# or rootless with the cpuset controller delegated.
CPUSET=1
# A cap against a runaway, not a reservation.
MEM_LIMIT=6G
# 1: pass the machine's NVIDIA GPUs to every container (needs the NVIDIA
# container toolkit).
GPU=0
# Seconds without notebook activity before a server is stopped (checked every
# 5 minutes). Stopping requeues the jobs running in it, so outlast the longest
# queue (4 hours).
CULL_TIMEOUT=18000
