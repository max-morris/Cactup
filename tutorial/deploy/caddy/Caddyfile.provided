# TLS=provided: the certificate and key the site gives you, in $TLS_CERT_DIR
# as cert.pem (with the intermediate certificates after it) and key.pem.
{
	auto_https disable_certs
}

{$DOMAIN} {
	tls /certs/cert.pem /certs/key.pem
	encode gzip
	header Strict-Transport-Security "max-age=604800"
	import hub.caddy
}
