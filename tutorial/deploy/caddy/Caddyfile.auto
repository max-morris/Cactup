# TLS=auto: Caddy gets and renews a certificate for $DOMAIN itself (Let's
# Encrypt), which needs the domain to point at this machine and ports 80 and
# 443 open to the internet. (No email given: Caddy renews by itself.)
{$DOMAIN} {
	encode gzip
	# Browsers that have been here come back over HTTPS only, for a week
	# (the workshop; not longer, the domain may serve other things later).
	header Strict-Transport-Security "max-age=604800"
	import hub.caddy
}
