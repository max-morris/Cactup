#!/usr/bin/python3 -I
"""Bring this container to the state a tutorial notebook assumes.

    cactup-tutorial-catch-up N

Every notebook's first cell runs it with its own number. It is idempotent:
it prints one line for each thing it had to do, and nothing when there was
nothing to do. See "Catch-up and reset" in tutorial/README.md.
"""

from __future__ import annotations

import json
import os
import re
import shutil
import subprocess
import sys
import time
from pathlib import Path

HOME = Path.home()
CACTUP_HOME = HOME / ".cactup"
CACTUP = CACTUP_HOME / "bin" / "cactup"
UPDATE_ROOT = Path("/opt/cactup-tutorial/update-root")
UPDATE_URL = "http://127.0.0.1:8765"
MACHINE = "cactup-tutorial"
RELEASE = "ET_2026_05_v0"
SAVED = HOME / "tutorial-saved"

# What each notebook needs before its first cell, beyond cactup itself.
NOTEBOOKS = {
    "1": {"cactup": False},
    "2": {"cactup": True, "install": True},
    # Notebook 3 compares its own installation with the stock one, but
    # makes et-mp the active one itself (and may be run again after that).
    "3": {"cactup": True, "install": True, "use": False},
    "4a": {"cactup": True, "install": True},
    # Notebook 4b ends by switching back to the stock tutorial config.
    "4b": {"cactup": True, "install": True, "tutorial": True},
    "5": {"cactup": True, "install": True, "tutorial": True},
    # Notebook 6a makes the machine entry mylab; 6b goes on with it.
    "6a": {"cactup": True, "install": True, "tutorial": True, "mylab": "fresh"},
    "6b": {"cactup": True, "install": True, "tutorial": True, "mylab": "finished"},
}
THORNLIST = "/opt/cactup-tutorial/thornlists/tutorial.th"

# The files notebooks edit in the stock install's source tree (relative to
# its Cactus directory), and which notebook edits each. Catch-up puts them
# back: the bakes all assume clean repositories, and the configs other than
# `tutorial` have no objects, so building one on an edited tree would
# compile everything.
EDITED = {
    "arrangements/CarpetX/WaveToyX/src/wavetoyx.cxx": "5",
    "arrangements/CarpetX/WaveToyX/param.ccl": "5",
    "src/main/Banner.c": "5",
}


def say(line: str) -> None:
    print(f"catch-up: {line}", flush=True)


def plain_env() -> dict:
    """The environment without the notebook kernel's color forcing
    (CLICOLOR_FORCE and friends), which would put color codes into output
    read through a pipe."""
    env = {k: v for k, v in os.environ.items() if k not in ("CLICOLOR_FORCE", "FORCE_COLOR", "CLICOLOR")}
    env["NO_COLOR"] = "1"
    return env


def cactup(*args: str, check: bool = True) -> subprocess.CompletedProcess:
    """Run cactup never on a terminal (so it never checks for updates or
    shows progress bars), with its output captured, uncolored."""
    proc = subprocess.run([str(CACTUP), *args], stdin=subprocess.DEVNULL, capture_output=True, text=True,
                          env=plain_env())
    if check and proc.returncode != 0:
        sys.stderr.write(proc.stdout + proc.stderr)
        raise SystemExit(f"catch-up: `cactup {' '.join(args)}` failed")
    return proc


def saved_dir() -> Path:
    """A new directory under ~/tutorial-saved, never one already used."""
    stamp = time.strftime("%Y-%m-%d-%H%M%S")
    for n in range(1000):
        d = SAVED / (stamp if n == 0 else f"{stamp}-{n}")
        try:
            d.mkdir(parents=True)
            return d
        except FileExistsError:
            continue
    raise SystemExit("catch-up: could not make a directory under ~/tutorial-saved")


# -- the machine ----------------------------------------------------------------


def discover_claims(script: Path) -> bool:
    """Whether a discover.py's is_machine() says yes for this host, run as
    cactup runs it; one that fails or hangs claims nothing."""
    # Like cactup: the script's own output goes to stderr, and anything it
    # raises, even SystemExit, means no claim.
    code = ("import contextlib, runpy, sys\n"
            "claims = False\n"
            "try:\n"
            "    with contextlib.redirect_stdout(sys.stderr):\n"
            "        claims = bool(runpy.run_path(sys.argv[1])['is_machine'](sys.argv[2]))\n"
            "except BaseException:\n"
            "    pass\n"
            "print(claims)")
    try:
        proc = subprocess.run(["python3", "-c", code, str(script), MACHINE], stdin=subprocess.DEVNULL,
                              capture_output=True, text=True, timeout=10)
    except subprocess.TimeoutExpired:
        return False
    return proc.returncode == 0 and proc.stdout.strip() == "True"


def claims_this_host(entry: Path) -> bool:
    if (entry / "discover.py").exists() and discover_claims(entry / "discover.py"):
        return True
    try:
        pattern = (entry / "hostname.regexp").read_text().strip()
    except OSError:
        return False
    try:
        # Unanchored, as cactup matches it.
        return bool(pattern) and re.search(pattern, MACHINE) is not None
    except re.error:
        return False


def machine(forget: bool = True) -> None:
    """Undo what would make cactup pick another machine than the tutorial's,
    or ask which one in a cell."""
    hostname_file = HOME / ".hostname"
    if hostname_file.exists():
        hostname_file.unlink()
        say("removed ~/.hostname (cactup would take this host's name from it)")
    user = CACTUP_HOME / "machines"
    if user.is_dir():
        for entry in sorted(user.iterdir()):
            if entry.is_dir() and (entry.name == MACHINE or claims_this_host(entry)):
                why = ("it has the tutorial machine's name, so cactup would use it instead"
                       if entry.name == MACHINE else "it claims this host")
                dest = saved_dir() / entry.name
                shutil.move(str(entry), dest)
                say(f"moved your machine entry {entry.name} to {dest} ({why})")
    try:
        detected = json.loads((CACTUP_HOME / "database.json").read_text()).get("detected") or {}
    except (OSError, ValueError):
        detected = {}
    if forget and detected.get("name") not in (None, MACHINE) and CACTUP.exists():
        cactup("machine", "forget")
        say(f"forgot the cached machine {detected['name']}")


# What notebook 6a sets in its machine entry, mylab: the lines catch-up 6b
# checks (a pattern for each line, and the line 6a leaves). The first
# pattern also takes 6a's deliberate typo.
MYLAB = "mylab"
MYLAB_LINES = [
    (r"^nickname\s*=.*$", 'nickname = "mylab"'),
    (r"^max-cpus?-per-node\s*=.*$", "max-cpus-per-node = 4"),
    (r"^memory\s*=.*$", "memory = 7372"),
    (r"^mdb-generation\s*=.*$", "mdb-generation = 1"),
]


def mylab(state: str) -> None:
    """Notebook 6a's machine entry: gone before 6a (`machine create` refuses
    an existing name), as 6a leaves it before 6b."""
    entry = CACTUP_HOME / "machines" / MYLAB
    if state == "fresh":
        if entry.exists():
            dest = saved_dir() / MYLAB
            shutil.move(str(entry), dest)
            say(f"moved your machine entry mylab to {dest}; this notebook makes it anew in its "
                "`machine create` cell")
        return
    if not entry.exists():
        cactup("machine", "create", MYLAB, "--from-existing", MACHINE, "--no-discover", "--silent")
        meta = entry / "meta.toml"
        meta.write_text(set_lines(meta.read_text()))
        say("made your machine entry mylab as notebook 6a leaves it")
        return
    meta = entry / "meta.toml"
    text = meta.read_text()
    fixed = set_lines(text)
    if fixed != text:
        copy = saved_dir() / "mylab-meta.toml"
        copy.write_text(text)
        meta.write_text(fixed)
        say(f"set mylab's nickname, [hardware] and mdb-generation as notebook 6a does; your "
            f"meta.toml is at ~/{copy.relative_to(HOME)}")


def set_lines(text: str) -> str:
    for pattern, line in MYLAB_LINES:
        text = re.sub(pattern, line, text, count=1, flags=re.M)
    return text


# -- cactup ---------------------------------------------------------------------


def builds() -> tuple[str, str]:
    """The update site's "previous" (what the installer installs) and
    "current" (what the update check offers) builds."""
    current = json.loads((UPDATE_ROOT / "latest.json").read_text())["build"]
    sha = next(UPDATE_ROOT.glob("*/cactup.sha256")).read_text()
    previous = re.search(r"cactup-(\w+)", sha).group(1)
    return previous, current


def installed_build() -> str | None:
    if not CACTUP.exists():
        return None
    out = cactup("--version", check=False).stdout
    m = re.search(r"\((\w+) ", out)
    return m.group(1) if m else ""


def install_cactup() -> None:
    proc = subprocess.run(
        ["sh", "-c", f"curl -sSf {UPDATE_URL}/cactup-init.sh | CACTUP_UPDATE_ROOT={UPDATE_URL} sh -s -- -y"],
        stdin=subprocess.DEVNULL, capture_output=True, text=True, env=plain_env(),
    )
    if proc.returncode != 0:
        sys.stderr.write(proc.stdout + proc.stderr)
        raise SystemExit("catch-up: the cactup installer failed")


def ensure_cactup() -> None:
    previous, current = builds()
    have = installed_build()
    if have is None:
        install_cactup()
        say("installed cactup with the documented installer (notebook 1 does this)")
    elif have not in (previous, current):
        # Not a build this VM serves (say, the public installer's): its output
        # differs from the notebooks', and it would miss every precomputed build.
        install_cactup()
        say(f"reinstalled cactup from this VM's update site (you had build {have})")
    if installed_build() != current:
        cactup("update")
        say(f"updated cactup to {current} (the first command on a terminal would have)")


# -- the install ----------------------------------------------------------------


def ensure_install(use: bool = True) -> None:
    listing = cactup("list").stdout
    if not re.search(rf"^- {re.escape(RELEASE)}(?=[ \t]|$)", listing, re.M):
        say(f"installing {RELEASE} from the mirrors (notebook 1 does this; under a minute)")
        cactup("install", RELEASE, "--silent")
        listing = cactup("list").stdout
    if use and not re.search(rf"^- {re.escape(RELEASE)}[ \t].*\(active\)", listing, re.M):
        cactup("use", RELEASE)
        say(f"made {RELEASE} the active installation")
    link = HOME / "Cactus"
    target = CACTUP_HOME / "cacti" / RELEASE / "Cactus"
    if not (link.is_symlink() and Path(os.readlink(link)) == target):
        if link.is_symlink() or not link.exists():
            if link.is_symlink():
                link.unlink()
            link.symlink_to(target)
            say(f"pointed ~/Cactus at {RELEASE}'s source tree")
        else:
            say("~/Cactus is not a link to the stock install; notebooks that use it will not find it")


def git(repo: Path, *args: str, check: bool = True) -> subprocess.CompletedProcess:
    return subprocess.run(["git", "-C", str(repo), *args], stdin=subprocess.DEVNULL, capture_output=True,
                          text=True, check=check)


def restore_edited() -> None:
    """Put the files notebooks edit back to their committed state, saving
    the attendee's versions outside the Cactus tree (a copy beside one would
    change its thorn's shape)."""
    cactus = CACTUP_HOME / "cacti" / RELEASE / "Cactus"
    saved = None
    for rel, notebook in EDITED.items():
        path = cactus / rel
        # The arrangements and src are links into the repositories.
        real = path.resolve()
        if not real.parent.is_dir():
            continue
        repo = Path(git(real.parent, "rev-parse", "--show-toplevel").stdout.strip())
        name = str(real.relative_to(repo))
        if git(repo, "diff", "--quiet", "HEAD", "--", name, check=False).returncode == 0:
            continue
        if saved is None:
            saved = saved_dir()
        shown = f"~/Cactus/{rel}"
        if real.exists():
            copy = saved / rel
            copy.parent.mkdir(parents=True, exist_ok=True)
            shutil.copy2(real, copy)
            where = f"your version is at ~/{copy.relative_to(HOME)}"
        else:
            where = "you had deleted it"
        git(repo, "checkout", "HEAD", "--", name)
        say(f"put {shown} back to its committed state (notebook {notebook} edits it); {where}")


def active_is_tutorial(listing: str) -> bool:
    """Whether `cactup config list` shows `tutorial` itself as the active
    config (not `tutorial-pinned` or another config whose name starts so)."""
    return re.search(r"^- tutorial[ \t].*\(active\)", listing, re.M) is not None


def ensure_tutorial() -> None:
    """The stock install's tutorial config, built from tutorial.th (notebook
    2's build), and the active config. Quiet when cactup calls it up to date
    (seconds); otherwise one line saying why, then cactup's own output as it
    comes, so a build never looks like a hang."""
    exists = (CACTUP_HOME / "cacti" / RELEASE / "Cactus" / "configs" / "tutorial").is_dir()
    proc = subprocess.Popen([str(CACTUP), "-I", RELEASE, "build", "tutorial", "--thornlist", THORNLIST],
                            stdin=subprocess.DEVNULL, stdout=subprocess.PIPE, stderr=subprocess.STDOUT,
                            text=True, env=plain_env())
    first = proc.stdout.readline()
    if re.search(r"\bis up to date\b", first):
        proc.stdout.read()
    elif exists:
        say(f"rebuilding the tutorial config in {RELEASE}: its sources changed since it was built "
            "(notebooks 5 and 9 edit some):")
        sys.stdout.write(first)
        for line in proc.stdout:
            sys.stdout.write(line)
            sys.stdout.flush()
    else:
        say(f"building the tutorial config in {RELEASE} (notebook 2 does this):")
        sys.stdout.write(first)
        for line in proc.stdout:
            sys.stdout.write(line)
            sys.stdout.flush()
    if proc.wait() != 0:
        raise SystemExit("catch-up: building the tutorial config failed")
    if not active_is_tutorial(cactup("-I", RELEASE, "config", "list").stdout):
        cactup("-I", RELEASE, "config", "use", "tutorial")
        say(f"made tutorial the active config of {RELEASE}")


def main(argv: list[str]) -> int:
    if len(argv) != 1 or argv[0] not in NOTEBOOKS:
        print(f"usage: cactup-tutorial-catch-up {{{','.join(NOTEBOOKS)}}}", file=sys.stderr)
        return 2
    needs = NOTEBOOKS[argv[0]]
    if not needs.get("cactup"):
        # Notebook 1 installs cactup and watches it update. Run again, its
        # installer puts back the older build, and a check made earlier
        # today would keep the update from happening: forget it. Otherwise
        # only what needs no cactup.
        (CACTUP_HOME / "update-check").unlink(missing_ok=True)
        machine(forget=False)
        return 0
    ensure_cactup()
    machine()
    if needs.get("install"):
        ensure_install(use=needs.get("use", True))
        # Restoring always comes before building.
        restore_edited()
    if needs.get("tutorial"):
        ensure_tutorial()
    if needs.get("mylab"):
        mylab(needs["mylab"])
    return 0


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
